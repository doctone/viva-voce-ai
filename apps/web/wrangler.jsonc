{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viva-voce-ai",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  "main": "@tanstack/react-start/server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Lets server routes read files from `public/`, e.g. /film.mp4 serving the
  // landing film in byte ranges. The Vite plugin fills in the directory.
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "SUPABASE_URL": "https://fbpgwluiblrmcmqfjaem.supabase.co"
  }
}
